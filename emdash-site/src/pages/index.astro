---
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import { getCmsPage } from "../lib/cms";

const { page, cacheHint } = await getCmsPage("home");
if (cacheHint) Astro.cache.set(cacheHint);

const title = page?.data?.title || "Care Farm in Western Albemarle";
const description =
	page?.data?.excerpt ||
	"Autism Sanctuary is a Virginia DBHDS-licensed working farm in Western Albemarle: meaningful days outdoors with trails, animals, gardens, and person-centered supports.";
const content = page?.data?.content ?? [];

// Do not spread page.edit.content here. Visual editing replaces custom layout
// blocks with placeholders ("Plugin block: asHero…") and breaks the homepage.
// Edit sections in Admin → Pages → home (click each layout block to open its form).
---

<Base title={title} description={description} image="/media/edgefield-aerial.jpg">
	{
		content.length > 0 ? (
			<div class="home-blocks">
				<PortableText value={content} />
			</div>
		) : (
			<section class="section section-cream">
				<div class="container">
					<h1>Homepage content missing</h1>
					<p class="lede">
						Publish the <code>home</code> page in EmDash admin, or run{" "}
						<code>node scripts/restore-cms-content.mjs --pages-only</code>.
					</p>
				</div>
			</section>
		)
	}
</Base>
