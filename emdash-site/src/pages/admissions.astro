---
import Base from "../layouts/Base.astro";
import CmsBanner from "../components/CmsBanner.astro";
import CmsBody from "../components/CmsBody.astro";
import InquiryForm from "../components/InquiryForm.astro";
import CtaBand from "../components/CtaBand.astro";
import { getCmsPage, pageEyebrows } from "../lib/cms";

const { page, cacheHint } = await getCmsPage("admissions");
if (cacheHint) Astro.cache.set(cacheHint);
if (!page) return Astro.redirect("/404");
---

<Base title="Admissions" description={page.data.excerpt || page.data.title}>
	<CmsBanner
		eyebrow={pageEyebrows.admissions}
		title={page.data.title}
		lede={page.data.excerpt}
		titleEdit={page.edit.title}
		ledeEdit={page.edit.excerpt}
	/>
	<CmsBody content={page.data.content} contentEdit={page.edit.content} class="section-cream" />

	<section class="section">
		<div class="container" style="max-width:48rem;">
			<InquiryForm defaultIntent="program-fit" heading="Explore a program fit" />
			<p class="privacy-note">
				For the full multi-step intake used in production, you may also use
				<a href="https://www.autismsanctuary.org/intake-form/" target="_blank" rel="noopener noreferrer"
					>the current intake form</a
				>
				while this EmDash site is staging.
			</p>
		</div>
	</section>

	<CtaBand
		title="Need waiver context first?"
		primaryHref="/resources"
		primaryLabel="Resources"
		secondaryHref="/programs"
		secondaryLabel="Programs"
		variant="meadow"
	/>
</Base>
