---
import Base from "../layouts/Base.astro";
import CmsBanner from "../components/CmsBanner.astro";
import CmsBody from "../components/CmsBody.astro";
import InquiryForm from "../components/InquiryForm.astro";
import CtaBand from "../components/CtaBand.astro";
import { getCmsPage, pageEyebrows } from "../lib/cms";

const { page, cacheHint } = await getCmsPage("careers");
if (cacheHint) Astro.cache.set(cacheHint);
if (!page) return Astro.redirect("/404");
---

<Base title="Careers &amp; volunteers" description={page.data.excerpt || page.data.title}>
	<CmsBanner
		eyebrow={pageEyebrows.careers}
		title={page.data.title}
		lede={page.data.excerpt}
		titleEdit={page.edit.title}
		ledeEdit={page.edit.excerpt}
	/>
	<CmsBody content={page.data.content} contentEdit={page.edit.content} class="section-cream" />

	<section class="section">
		<div class="container" style="max-width:48rem;">
			<InquiryForm defaultIntent="jobs" heading="Inquire about jobs or volunteering" />
			<p class="privacy-note">
				Select <strong>Job opportunities</strong> or <strong>Volunteering</strong> in the intent field so we can
				route your note.
			</p>
		</div>
	</section>

	<CtaBand
		title="Prefer email?"
		text="Reach info@autismsanctuary.org with a short introduction and the role you have in mind."
		primaryHref="/contact"
		primaryLabel="Contact"
		secondaryHref="/donate"
		secondaryLabel="Donate"
		variant="meadow"
	/>
</Base>
