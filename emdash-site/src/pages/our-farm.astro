---
import Base from "../layouts/Base.astro";
import CmsBanner from "../components/CmsBanner.astro";
import CmsBody from "../components/CmsBody.astro";
import CtaBand from "../components/CtaBand.astro";
import { getCmsPage, pageEyebrows } from "../lib/cms";

const { page, cacheHint } = await getCmsPage("our-farm");
if (cacheHint) Astro.cache.set(cacheHint);
if (!page) return Astro.redirect("/404");
---

<Base
	title="Our farm"
	description={page.data.excerpt || page.data.title}
	image="/media/edgefield-aerial.jpg"
>
	<CmsBanner
		eyebrow={pageEyebrows["our-farm"]}
		title={page.data.title}
		lede={page.data.excerpt}
		titleEdit={page.edit.title}
		ledeEdit={page.edit.excerpt}
	/>
	<CmsBody content={page.data.content} contentEdit={page.edit.content} class="section-cream" />
	<CtaBand
		title="Come see how the land shapes the day"
		primaryHref="/contact"
		primaryLabel="Contact us"
		secondaryHref="/donate"
		secondaryLabel="Support the farm"
	/>
</Base>
