---
import Base from "../../layouts/Base.astro";
---

<Base title="Thank you" description="Thank you for supporting Autism Sanctuary." noIndex={true}>
	<section class="page-banner">
		<div class="container" style="max-width:40rem;">
			<span class="eyebrow">Donation received</span>
			<h1>Thank you for standing with Autism Sanctuary.</h1>
			<p class="lede">
				Your gift helps keep trails open, gardens growing, and farm days joyful for people with significant
				support needs. Stripe will email your receipt.
			</p>
			<div class="cta-row">
				<a class="btn btn-primary" href="/">Return home</a>
				<a class="btn btn-secondary" href="/our-farm">See the farm</a>
			</div>
		</div>
	</section>
</Base>
