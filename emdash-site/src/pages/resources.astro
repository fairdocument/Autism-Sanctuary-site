---
import Base from "../layouts/Base.astro";
import CmsBanner from "../components/CmsBanner.astro";
import CmsBody from "../components/CmsBody.astro";
import CtaBand from "../components/CtaBand.astro";
import { getCmsPage, pageEyebrows } from "../lib/cms";

const { page, cacheHint } = await getCmsPage("resources");
if (cacheHint) Astro.cache.set(cacheHint);
if (!page) return Astro.redirect("/404");
---

<Base title="Resources" description={page.data.excerpt || page.data.title}>
	<CmsBanner
		eyebrow={pageEyebrows.resources}
		title={page.data.title}
		lede={page.data.excerpt}
		titleEdit={page.edit.title}
		ledeEdit={page.edit.excerpt}
	/>
	<CmsBody content={page.data.content} contentEdit={page.edit.content} class="section-cream" />
	<CtaBand
		title="Questions about funding or access?"
		primaryHref="/contact?intent=program-fit"
		primaryLabel="Send an inquiry"
		secondaryHref="/admissions"
		secondaryLabel="Admissions"
	/>
</Base>
