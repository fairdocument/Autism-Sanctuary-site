---
import Base from "../layouts/Base.astro";
import CmsBanner from "../components/CmsBanner.astro";
import CmsBody from "../components/CmsBody.astro";
import CtaBand from "../components/CtaBand.astro";
import { getCmsPage, pageEyebrows } from "../lib/cms";

const { page, cacheHint } = await getCmsPage("programs");
if (cacheHint) Astro.cache.set(cacheHint);
if (!page) return Astro.redirect("/404");
---

<Base title="Programs" description={page.data.excerpt || page.data.title}>
	<CmsBanner
		eyebrow={pageEyebrows.programs}
		title={page.data.title}
		lede={page.data.excerpt}
		titleEdit={page.edit.title}
		ledeEdit={page.edit.excerpt}
	/>
	<CmsBody content={page.data.content} contentEdit={page.edit.content} class="section-cream" />
	<CtaBand
		title="Next step: admissions conversation"
		text="Families, guardians, and case managers can begin with a respectful, clear intake conversation."
		primaryHref="/admissions"
		primaryLabel="Admissions"
		secondaryHref="/resources"
		secondaryLabel="Waiver resources"
	/>
</Base>
