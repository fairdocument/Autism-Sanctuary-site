---
import Base from "../layouts/Base.astro";
import CtaBand from "../components/CtaBand.astro";
---

<Base
	title="Programs"
	description="Licensed DBHDS services at Autism Sanctuary: day supports, residential pathways, respite, workplace assistance, and outdoor programming."
>
	<section class="page-banner">
		<div class="container">
			<span class="eyebrow">Programs &amp; licensed services</span>
			<h1>Programs that embrace the outdoors.</h1>
			<p class="lede">
				Autism Sanctuary is a Virginia DBHDS-licensed farm serving people with autism and IDD—most of whom need
				substantial daily support. Licensed services show up alongside trails, animals, gardens, and friends.
			</p>
		</div>
	</section>

	<section class="section-tight">
		<div class="container">
			<div class="note">
				<strong>Authorization and eligibility:</strong> Service availability, waiver funding, and ISP
				authorization vary by person and payer. See <a href="/resources">Resources</a> or
				<a href="/admissions">Admissions</a>.
			</div>
		</div>
	</section>

	<section class="section section-cream">
		<div class="container">
			<div class="section-head">
				<span class="eyebrow">Licensed service lines</span>
				<h2>DBHDS-authorized supports delivered with skill—and a sense of fun.</h2>
			</div>
			<div class="grid-3">
				<article class="feature-block">
					<span class="eyebrow">Day &amp; community</span>
					<h3>Group Day &amp; Community Coaching</h3>
					<p>
						Weekday person-centered support in a natural learning environment: therapeutic horticulture,
						animal care, sensory-informed routines, and guided community engagement.
					</p>
					<ul class="checklist">
						<li>Evidence-based practice in daily coaching and documentation</li>
						<li>Small-group and side-by-side modeling with trained DSPs</li>
						<li>Community outings at each person’s pace</li>
					</ul>
				</article>
				<article class="feature-block">
					<span class="eyebrow">Residential</span>
					<h3>Residential &amp; Home-Based Supports</h3>
					<p>
						Lifespan support for adults who benefit from stable, individualized residential arrangements
						where authorized—Sponsored Residential, In-Home Support, and Supported Living pathways.
					</p>
					<ul class="checklist">
						<li>Person-centered planning aligned with ISP goals</li>
						<li>Trauma-informed, dignity-first daily living</li>
						<li>Coordination with medical and community partners</li>
					</ul>
				</article>
				<article class="feature-block">
					<span class="eyebrow">Vocational</span>
					<h3>Workplace Assistance</h3>
					<p>
						Structured support for paid or volunteer community roles when that matches a person’s
						goals—including task analysis, workplace navigation, and retention supports.
					</p>
					<ul class="checklist">
						<li>1:1 and small-team coaching</li>
						<li>Employer partnership and natural supports</li>
						<li>Focus on long-term success</li>
					</ul>
				</article>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container split">
			<div class="stack prose-wide">
				<span class="eyebrow">Group day programming</span>
				<h2>Full days outside for people with significant support needs.</h2>
				<p>
					Group Day gives people a planned routine with safe, structured programming under professional
					supervision. At Autism Sanctuary, that still means animals, trails, gardens, and playful
					routines—planned with the same care we bring to every licensed service day.
				</p>
				<a class="btn btn-primary" href="/contact?intent=program-fit">Explore a program fit</a>
			</div>
			<figure class="media-frame">
				<img
					src="/media/farm-activity.jpg"
					alt="Outdoor activity on the Autism Sanctuary farm."
					width="1080"
					height="675"
					loading="lazy"
					decoding="async"
				/>
			</figure>
		</div>
	</section>

	<CtaBand
		title="Next step: admissions conversation"
		text="Families, guardians, and case managers can begin with a respectful, clear intake conversation."
		primaryHref="/admissions"
		primaryLabel="Admissions"
		secondaryHref="/resources"
		secondaryLabel="Waiver resources"
	/>
</Base>
