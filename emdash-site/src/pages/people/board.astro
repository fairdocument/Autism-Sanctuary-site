---
import Base from "../../layouts/Base.astro";
import PersonList from "../../components/PersonList.astro";
import CtaBand from "../../components/CtaBand.astro";
import { boardMembers } from "../../content/siteCopy";
---

<Base
	title="Board of directors"
	description="Autism Sanctuary board of directors: Jason Brewster (President), Robert Kreps (Treasurer), Matthew Osborne (Secretary), and Rose Neville."
>
	<section class="page-banner">
		<div class="container">
			<span class="eyebrow">People · Board</span>
			<h1>Board of directors</h1>
			<p class="lede">
				Volunteer directors who provide governance, fiduciary oversight, and mission clarity for Autism
				Sanctuary.
			</p>
			<div class="people-subnav" aria-label="People sections">
				<a href="/people">Overview</a>
				<a href="/people/board" aria-current="page">Board</a>
				<a href="/people/management">Management</a>
			</div>
		</div>
	</section>

	<section class="section section-cream">
		<div class="container">
			<div class="section-head">
				<span class="eyebrow">Directors</span>
				<h2>Names, roles, and biographies</h2>
				<p class="lede" style="margin:0;">
					Portraits and full biographies are placeholders for now and will be updated as materials are
					ready.
				</p>
			</div>
			<PersonList people={boardMembers} />
		</div>
	</section>

	<CtaBand
		title="Meet our management team"
		text="Day-to-day leadership for programs and adult services."
		primaryHref="/people/management"
		primaryLabel="Management"
		secondaryHref="/contact"
		secondaryLabel="Contact us"
	/>
</Base>
