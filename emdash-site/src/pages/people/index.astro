---
import Base from "../../layouts/Base.astro";
import CmsBanner from "../../components/CmsBanner.astro";
import CmsBody from "../../components/CmsBody.astro";
import PersonList from "../../components/PersonList.astro";
import CtaBand from "../../components/CtaBand.astro";
import { boardMembers, managementTeam } from "../../content/siteCopy";
import { getCmsPage, pageEyebrows } from "../../lib/cms";

const { page, cacheHint } = await getCmsPage("people");
if (cacheHint) Astro.cache.set(cacheHint);
if (!page) return Astro.redirect("/404");
---

<Base title="People" description={page.data.excerpt || page.data.title}>
	<CmsBanner
		eyebrow={pageEyebrows.people}
		title={page.data.title}
		lede={page.data.excerpt}
		titleEdit={page.edit.title}
		ledeEdit={page.edit.excerpt}
	/>
	<CmsBody content={page.data.content} contentEdit={page.edit.content} class="section-cream" />

	<section class="section section-cream" id="board">
		<div class="container">
			<div class="section-head">
				<span class="eyebrow">Board of directors</span>
				<h2>Volunteer leaders guiding mission and oversight.</h2>
			</div>
			<PersonList people={boardMembers} />
		</div>
	</section>

	<section class="section" id="management">
		<div class="container">
			<div class="section-head">
				<span class="eyebrow">Management</span>
				<h2>Staff leadership for programs and daily operations.</h2>
			</div>
			<PersonList people={managementTeam} />
		</div>
	</section>

	<CtaBand
		title="Want to join the work?"
		text="Explore careers, volunteering, or reach out with a question."
		primaryHref="/careers"
		primaryLabel="Careers &amp; volunteers"
		secondaryHref="/contact"
		secondaryLabel="Contact us"
	/>
</Base>
