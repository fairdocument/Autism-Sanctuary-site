---
import Base from "../layouts/Base.astro";
import CmsBanner from "../components/CmsBanner.astro";
import CmsBody from "../components/CmsBody.astro";
import DonateCheckout from "../components/DonateCheckout.astro";
import InquiryForm from "../components/InquiryForm.astro";
import { getCmsPage, pageEyebrows } from "../lib/cms";

const canceled = Astro.url.searchParams.get("canceled") === "1";
const { page, cacheHint } = await getCmsPage("donate");
if (cacheHint) Astro.cache.set(cacheHint);
if (!page) return Astro.redirect("/404");
---

<Base title="Donate" description={page.data.excerpt || page.data.title}>
	<CmsBanner
		eyebrow={pageEyebrows.donate}
		title={page.data.title}
		lede={page.data.excerpt}
		titleEdit={page.edit.title}
		ledeEdit={page.edit.excerpt}
	/>
	{
		canceled && (
			<section class="section-tight">
				<div class="container">
					<p class="note">
						Checkout was canceled. You can adjust your gift below, or
						<a href="/contact?intent=donate">ask us about other ways to give</a>.
					</p>
				</div>
			</section>
		)
	}
	<CmsBody content={page.data.content} contentEdit={page.edit.content} class="section-cream" />

	<section class="section section-cream">
		<div class="container split">
			<div class="stack">
				<span class="eyebrow">Give now</span>
				<h2>Secure checkout with Stripe</h2>
				<p class="lede">
					One-time or monthly gifts. Choose an amount, how you would like it used, and whether this gift is
					in honor of someone.
				</p>
				<DonateCheckout />
			</div>
			<div class="stack">
				<span class="eyebrow">Where gifts go</span>
				<article class="feature-block">
					<h3>Care farming infrastructure</h3>
					<p>Trails, high tunnels, tools, and safety systems that make pre-vocational training possible.</p>
				</article>
				<article class="feature-block">
					<h3>Participant access</h3>
					<p>Supports that reduce barriers to community engagement and inclusive programming.</p>
				</article>
				<article class="feature-block">
					<h3>Workforce strength</h3>
					<p>
						Training stipends, wellness resources, and the
						<a href="/fellowship">Siemers Fellowship</a>.
					</p>
				</article>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container" style="max-width:48rem;">
			<div class="note" style="margin-bottom:1.5rem;">
				<strong>501(c)(3) acknowledgment:</strong> Autism Sanctuary is a nonprofit organization; consult the
				development team for gift acknowledgment letters and tax substantiation.
			</div>
			<InquiryForm defaultIntent="donate" heading="Questions about donating?" />
		</div>
	</section>
</Base>
