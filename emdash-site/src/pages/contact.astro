---
import Base from "../layouts/Base.astro";
import CmsBanner from "../components/CmsBanner.astro";
import CmsBody from "../components/CmsBody.astro";
import InquiryForm from "../components/InquiryForm.astro";
import { brand, inquiryIntents, type InquiryIntent } from "../content/siteCopy";
import { getCmsPage, pageEyebrows } from "../lib/cms";

const intentParam = Astro.url.searchParams.get("intent") || "general";
const defaultIntent = inquiryIntents.some((i) => i.value === intentParam)
	? (intentParam as InquiryIntent)
	: "general";

const { page, cacheHint } = await getCmsPage("contact");
if (cacheHint) Astro.cache.set(cacheHint);
if (!page) return Astro.redirect("/404");
---

<Base title="Contact" description={page.data.excerpt || page.data.title}>
	<CmsBanner
		eyebrow={pageEyebrows.contact}
		title={page.data.title}
		lede={page.data.excerpt}
		titleEdit={page.edit.title}
		ledeEdit={page.edit.excerpt}
	/>
	<CmsBody content={page.data.content} contentEdit={page.edit.content} />

	<section class="section section-cream">
		<div class="container split">
			<aside class="stack">
				<h2>Visit &amp; phone</h2>
				<p>
					<strong>Address:</strong><br />
					{brand.address}
				</p>
				<p>
					<strong>Phone:</strong>
					<a href={brand.phoneHref}>{brand.phone}</a><br />
					<strong>Email:</strong>
					<a href={`mailto:${brand.email}`}>{brand.email}</a>
				</p>
				<p>
					<strong>Social:</strong>
					<a href={brand.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
					·
					<a href={brand.facebook} target="_blank" rel="noopener noreferrer">Facebook</a>
					·
					<a href={brand.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
				</p>
				<figure class="media-frame">
					<img
						src="/media/edgefield-house.jpg"
						alt="Edgefield house at Autism Sanctuary."
						width="2560"
						height="1707"
						loading="lazy"
						decoding="async"
					/>
				</figure>
			</aside>
			<InquiryForm defaultIntent={defaultIntent} heading="Send an inquiry" />
		</div>
	</section>
</Base>
