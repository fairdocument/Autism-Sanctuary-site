---
import Base from "../layouts/Base.astro";
---

<Base title="Privacy" description="Privacy policy for Autism Sanctuary.">
	<section class="page-banner">
		<div class="container prose-wide">
			<span class="eyebrow">Legal</span>
			<h1>Privacy</h1>
			<p class="lede">
				Autism Sanctuary collects contact information you submit through inquiry and donation forms to respond
				to your request and process gifts. We do not sell personal information. Payment details are processed by
				Stripe and are not stored on this site.
			</p>
			<p>
				For privacy questions, email
				<a href="mailto:info@autismsanctuary.org">info@autismsanctuary.org</a>.
			</p>
		</div>
	</section>
</Base>
