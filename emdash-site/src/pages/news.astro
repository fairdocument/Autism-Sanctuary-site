---
import Base from "../layouts/Base.astro";
---

<Base title="News" description="News and updates from Autism Sanctuary.">
	<section class="page-banner">
		<div class="container">
			<span class="eyebrow">Newsroom</span>
			<h1>News &amp; updates</h1>
			<p class="lede">
				Farm stories, program updates, and community notes will live here. For now, follow us on social or
				reach out directly.
			</p>
			<div class="cta-row">
				<a class="btn btn-primary" href="https://www.instagram.com/autismsanctuary" target="_blank" rel="noopener noreferrer"
					>Instagram</a
				>
				<a class="btn btn-secondary" href="/contact">Contact</a>
			</div>
		</div>
	</section>
</Base>
