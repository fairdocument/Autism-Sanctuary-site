---
import { getSiteSettings } from "emdash";
import { EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Font } from "astro:assets";
import { brand, footerLinks, navItems } from "../content/siteCopy";
import "../styles/theme.css";

interface Props {
	title?: string;
	description?: string;
	image?: string;
	type?: "website" | "article";
	noIndex?: boolean;
}

const { title, description, image, type = "website", noIndex = false } = Astro.props;
const settings = await getSiteSettings();
const siteTitle = settings?.title || brand.name;
const fullTitle = title ? `${title} — ${siteTitle}` : siteTitle;
const siteDescription = description || settings?.tagline || brand.tagline;
const path = Astro.url.pathname;
const ogImage = image || "/media/edgefield-aerial.jpg";

const pageCtx = createPublicPageContext({
	Astro,
	kind: "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: title ?? siteTitle,
	description: siteDescription,
	canonical: Astro.url.href,
	image: ogImage,
	seo: { ogImage },
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<meta name="description" content={siteDescription} />
		{noIndex && <meta name="robots" content="noindex,nofollow" />}
		<link rel="icon" href="/branding/autism-sanctuary-logo.png" type="image/png" />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={siteDescription} />
		<meta property="og:type" content={type} />
		<meta property="og:url" content={Astro.url.href} />
		<meta property="og:image" content={new URL(ogImage, Astro.site || Astro.url).href} />
		<meta name="twitter:card" content="summary_large_image" />
		<EmDashHead page={pageCtx} />
		<Font cssVariable="--font-serif" preload />
		<Font cssVariable="--font-sans" preload />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<header class="site-header" data-header>
			<nav class="nav" aria-label="Primary">
				<a href="/" class="brand" aria-label={`${brand.name} home`}>
					<img
						src="/branding/autism-sanctuary-logo.png"
						alt=""
						width="48"
						height="48"
						class="brand-logo"
						decoding="async"
					/>
					<span class="brand-name">{brand.name}</span>
				</a>
				<button type="button" class="nav-toggle" aria-expanded="false" aria-controls="primary-nav" data-nav-toggle>
					<span class="sr-only">Menu</span>
					<span></span><span></span>
				</button>
				<div class="nav-links" id="primary-nav" data-nav-panel>
					{
						navItems.map((item) => {
							const isActive =
								path === item.href ||
								(item.href !== "/" && path.startsWith(`${item.href}/`)) ||
								(item.children?.some(
									(child) => path === child.href || path.startsWith(`${child.href}/`),
								) ??
									false);

							if (item.children?.length) {
								return (
									<div class:list={["nav-item", "has-children", { active: isActive }]}>
										<a
											href={item.href}
											class:list={["nav-link", { active: isActive }]}
											aria-haspopup="true"
											aria-expanded="false"
											data-nav-parent
										>
											{item.label}
											<span class="nav-caret" aria-hidden="true" />
										</a>
										<div class="nav-dropdown" role="group" aria-label={`${item.label} submenu`}>
											{item.children.map((child) => (
												<a
													href={child.href}
													class:list={[
														"nav-link",
														"nav-dropdown-link",
														{
															active:
																path === child.href ||
																path.startsWith(`${child.href}/`),
														},
													]}
												>
													{child.label}
												</a>
											))}
										</div>
									</div>
								);
							}

							return (
								<a
									href={item.href}
									class:list={[
										"nav-link",
										{ "nav-cta": item.cta },
										{ active: isActive },
									]}
								>
									{item.label}
								</a>
							);
						})
					}
				</div>
			</nav>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="footer-inner">
				<div class="footer-brand">
					<img
						src="/branding/autism-sanctuary-logo.png"
						alt=""
						width="56"
						height="56"
						class="footer-logo"
						decoding="async"
					/>
					<p class="footer-name">{brand.name}</p>
					<p class="footer-tagline">{brand.tagline}</p>
					<p class="footer-address">{brand.address}</p>
					<p class="footer-contact">
						<a href={brand.phoneHref}>{brand.phone}</a>
						·
						<a href={`mailto:${brand.email}`}>{brand.email}</a>
					</p>
					<p class="footer-social">
						<a href={brand.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
						·
						<a href={brand.facebook} target="_blank" rel="noopener noreferrer">Facebook</a>
					</p>
				</div>
				<nav class="footer-col" aria-label="Explore">
					<h2>Explore</h2>
					{footerLinks.explore.map((item) => (
						<a href={item.href}>{item.label}</a>
					))}
				</nav>
				<nav class="footer-col" aria-label="Engage">
					<h2>Engage</h2>
					{footerLinks.engage.map((item) => (
						<a href={item.href}>{item.label}</a>
					))}
				</nav>
				<nav class="footer-col" aria-label="Legal">
					<h2>Legal</h2>
					{footerLinks.legal.map((item) => (
						<a href={item.href}>{item.label}</a>
					))}
				</nav>
			</div>
			<div class="footer-bottom">
				<span>© {new Date().getFullYear()} Autism Sanctuary. {brand.legal}</span>
			</div>
		</footer>

		<script>
			const header = document.querySelector("[data-header]");
			const toggle = document.querySelector("[data-nav-toggle]");
			const panel = document.querySelector("[data-nav-panel]");
			const parents = document.querySelectorAll<HTMLElement>("[data-nav-parent]");

			const onScroll = () => {
				header?.classList.toggle("is-scrolled", window.scrollY > 24);
			};
			onScroll();
			window.addEventListener("scroll", onScroll, { passive: true });

			toggle?.addEventListener("click", () => {
				const open = toggle.getAttribute("aria-expanded") === "true";
				toggle.setAttribute("aria-expanded", String(!open));
				panel?.classList.toggle("is-open", !open);
			});

			parents.forEach((parent) => {
				parent.addEventListener("click", (event) => {
					if (window.matchMedia("(max-width: 900px)").matches) {
						const item = parent.closest(".nav-item");
						const alreadyOpen = item?.classList.contains("is-open");
						if (!alreadyOpen) {
							event.preventDefault();
							document.querySelectorAll(".nav-item.is-open").forEach((el) => {
								el.classList.remove("is-open");
								el.querySelector("[data-nav-parent]")?.setAttribute("aria-expanded", "false");
							});
							item?.classList.add("is-open");
							parent.setAttribute("aria-expanded", "true");
						}
					}
				});
			});
		</script>
	</body>
</html>
